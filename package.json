{
  "name": "task-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && node server.js",
    "start:dev": "concurrently -n \"FRONTEND,BACKEND\" -c \"blue,green\" \"npm run dev\" \"node server.js\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "axios": "^1.13.4",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@types/express": "^4.17.21",
    "concurrently": "^8.2.2",
    "sass": "^1.77.8",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
